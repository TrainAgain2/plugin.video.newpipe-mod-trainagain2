"Language: pt_BR\n"

msgctxt "#30020"
msgid "General"
msgstr "Geral"

msgctxt "#30021"
msgid "Results per page"
msgstr "Resultados por página"

msgctxt "#30022"
msgid "Feed items per channel"
msgstr "Itens do feed por canal"

msgctxt "#30023"
msgid "Audio only"
msgstr "Somente áudio"

msgctxt "#30024"
msgid "Debug (disable cache)"
msgstr "Depuração (desativar cache)"

msgctxt "#30031"
msgid "Clear cache"
msgstr "Limpar cache"

msgctxt "#30035"
msgid "Content country (ISO 3166-1)"
msgstr "País do conteúdo"

msgctxt "#30036"
msgid "Content language (YouTube code)"
msgstr "Idioma do conteúdo"

msgctxt "#30037"
msgid "Direct playback maximum resolution"
msgstr "Resolução máxima da reprodução progressiva"

msgctxt "#30038"
msgid "Uses one direct audio/video stream and avoids the failing DASH proxy."
msgstr "Usa fluxo direto sem proxy local. Quando o YouTube retornar HLS, usa inputstream.adaptive diretamente."

msgctxt "#30039"
msgid "Fast start"
msgstr "Início rápido"

msgctxt "#30040"
msgid "Prefer a 360p/480p direct stream when available. Disable this to prefer the highest selected resolution."
msgstr "Prefere um fluxo direto de 360p/480p quando disponível. Desative para priorizar a maior resolução selecionada."

msgctxt "#30041"
msgid "Custom country code (optional)"
msgstr "Código de país personalizado (opcional)"

msgctxt "#30042"
msgid "Enter any two-letter ISO 3166-1 country code. It overrides the country picker."
msgstr "Informe qualquer código de país ISO 3166-1 de duas letras. Ele substitui a seleção de país."

msgctxt "#30043"
msgid "Custom language code (optional)"
msgstr "Código de idioma personalizado (opcional)"

msgctxt "#30044"
msgid "Enter a YouTube language code such as pt, pt-PT, en or es. It overrides the language picker."
msgstr "Informe um código de idioma do YouTube, como pt, pt-PT, en ou es. Ele substitui a seleção de idioma."

msgctxt "#30045"
msgid "Select the country used by YouTube to localize results."
msgstr "Selecione o país usado pelo YouTube para localizar os resultados."

msgctxt "#30046"
msgid "Select the language used by YouTube to localize titles and results."
msgstr "Selecione o idioma usado pelo YouTube para localizar títulos e resultados."

msgctxt "#30047"
msgid "Default Trending category"
msgstr "Categoria padrão de Tendências"

msgctxt "#30048"
msgid "Choose the category that opens immediately when selecting Trending."
msgstr "Escolha a categoria que abre imediatamente ao selecionar Tendências."

msgctxt "#30049"
msgid "Default Live category"
msgstr "Categoria padrão de Ao vivo"

msgctxt "#30050"
msgid "Choose the category that opens immediately when selecting Live."
msgstr "Escolha a categoria que abre imediatamente ao selecionar Ao vivo."

msgctxt "#30051"
msgid "Trailers"
msgstr "Trailers"

msgctxt "#30052"
msgid "Trailer language/version"
msgstr "Idioma/versão dos trailers"

msgctxt "#30053"
msgid "Choose how trailers are searched. This is independent of the selected content country."
msgstr "Escolha como os trailers são pesquisados. Esta opção é independente do país de conteúdo selecionado."

msgctxt "#30054"
msgid "Trailer maximum resolution"
msgstr "Resolução máxima dos trailers"

msgctxt "#30055"
msgid "Choose the resolution requested for trailers. 4K depends on availability, device decoding and InputStream Adaptive settings."
msgstr "Escolha a resolução solicitada para trailers. 4K depende da disponibilidade, decodificação do aparelho e configurações do InputStream Adaptive."

msgctxt "#30056"
msgid "Delete all watch history"
msgstr "Eliminar todo o histórico de reprodução"

msgctxt "#30057"
msgid "Remove from watch history"
msgstr "Remover do histórico de reprodução"

msgctxt "#30058"
msgid "Delete all watched videos from the local history?"
msgstr "Eliminar todos os vídeos assistidos do histórico local?"

msgctxt "#30059"
msgid "YouTube account"
msgstr "Conta do YouTube"

msgctxt "#30060"
msgid "Connect YouTube account"
msgstr "Fazer login no YouTube"

msgctxt "#30061"
msgid "Sync YouTube subscriptions"
msgstr "Sincronizar subscrições do YouTube"

msgctxt "#30062"
msgid "Disconnect YouTube account"
msgstr "Terminar sessão do YouTube"

msgctxt "#30064"
msgid "YouTube authorization is pending"
msgstr "Conclua o login do YouTube no navegador"

msgctxt "#30065"
msgid "Open this address in a browser:"
msgstr "Abra este endereço num navegador:"

msgctxt "#30066"
msgid "Enter this code:"
msgstr "Informe este código:"

msgctxt "#30067"
msgid "Connection setup failed"
msgstr "Falha ao preparar a ligação"

msgctxt "#30068"
msgid "After authorization, NewPipe synchronizes automatically."
msgstr "Depois de autorizar, o NewPipe entra na conta e sincroniza automaticamente."

msgctxt "#30069"
msgid "YouTube subscriptions synchronized: {0}"
msgstr "Subscrições do YouTube sincronizadas: {0}"

msgctxt "#30070"
msgid "YouTube sync failed: {0}"
msgstr "Falha ao sincronizar o YouTube: {0}"

msgctxt "#30071"
msgid "The YouTube authorization code expired. Start again."
msgstr "O código de autorização do YouTube expirou. Inicie novamente."

msgctxt "#30072"
msgid "Disconnect from YouTube? Local subscriptions remain."
msgstr "Desconectar do YouTube? As subscrições locais permanecem."

msgctxt "#30073"
msgid "YouTube account disconnected"
msgstr "Conta do YouTube desconectada"

msgctxt "#30074"
msgid "YouTube TV login method"
msgstr "Método de login YouTube TV"

msgctxt "#30075"
msgid "Uses the current public YouTube TV client data, following NewPipe MOD's activation flow."
msgstr "Usa os dados públicos atuais do cliente YouTube TV, seguindo o fluxo de ativação do NewPipe MOD."

msgctxt "#30076"
msgid "Creates a YouTube TV activation code and QR. Authorize it with your Google account on another device."
msgstr "Cria um código e QR de ativação YouTube TV. Autorize-o com a sua conta Google noutro aparelho."

msgctxt "#30077"
msgid "Imports the current account subscriptions after YouTube TV authorization."
msgstr "Importa as subscrições da conta depois da autorização YouTube TV."

msgctxt "#30078"
msgid "Removes the local OAuth token only. It never changes your YouTube subscriptions."
msgstr "Remove somente o login local. Nunca modifica as suas subscrições do YouTube."

msgctxt "#30079"
msgid "YouTube account is already connected"
msgstr "A conta do YouTube já está conectada"

msgctxt "#30080"
msgid "QR link:"
msgstr "Link do QR:"

msgctxt "#30081"
msgid "No Google Cloud client configuration is required"
msgstr "Não é preciso configurar um cliente Google Cloud"

msgctxt "#30082"
msgid "The public YouTube TV client is fetched when a new activation code is created and cached only in the local addon profile."
msgstr "O cliente público YouTube TV é obtido ao criar um novo código e fica em cache apenas no perfil local do add-on."

msgctxt "#30083"
msgid "Subscribed channels"
msgstr "Canais subscritos"

msgctxt "#30084"
msgid "My YouTube"
msgstr "A minha conta do YouTube"

msgctxt "#30085"
msgid "My subscriptions"
msgstr "As minhas subscrições"

msgctxt "#30086"
msgid "Watch Later"
msgstr "Ver mais tarde"

msgctxt "#30087"
msgid "Saved playlists"
msgstr "Playlists guardadas"

msgctxt "#30088"
msgid "Add to Watch Later"
msgstr "Adicionar a Ver mais tarde"

msgctxt "#30089"
msgid "Remove from Watch Later"
msgstr "Remover de Ver mais tarde"

msgctxt "#30090"
msgid "Local watch history"
msgstr "Histórico de reprodução local"

msgctxt "#30034"
msgid "Next page"
msgstr "Próxima página"

msgctxt "#30091"
msgid "Step 1 — Scan QR code"
msgstr "Passo 1 — Digitalizar QR Code"

msgctxt "#30092"
msgid "Step 2 — Use manual code: {0}"
msgstr "Passo 2 — Usar código manual: {0}"

msgctxt "#30093"
msgid "Step 3 — Confirm connection"
msgstr "Passo 3 — Confirmar ligação"

msgctxt "#30094"
msgid "Generate new code"
msgstr "Gerar novo código"

msgctxt "#30095"
msgid "Cancel connection"
msgstr "Cancelar ligação"
